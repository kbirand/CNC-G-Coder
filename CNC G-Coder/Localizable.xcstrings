    },
    "Mask openings are exported as 1:1 SVGs for laser ablation instead of milling.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les ouvertures du vernis sont exportées en SVG 1:1 pour ablation laser au lieu du fraisage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las aberturas de máscara se exportan como SVG 1:1 para ablación láser en lugar de fresarse."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maske açıklıkları frezelemek yerine lazer ablasyonu için 1:1 SVG olarak dışa aktarılır."
          }
        }
      }
    },
    "Material Removal": {
      "localizations": {
