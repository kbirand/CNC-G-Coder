          }
        }
      }
    },
    "Editing %@" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editando %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modification de %@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ düzenleniyor"
          }
        }
      }
    },
    "Editing %@. Each change writes an edited copy — the original file is never modified. The toolpaths regenerate from it when you press Done." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editando %@. Cada cambio escribe una copia editada; el archivo original nunca se modifica. Las trayectorias se regeneran a partir de ella al pulsar Done."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modification de %@. Chaque changement écrit une copie modifiée — le fichier d'origine n'est jamais touché. Les parcours se régénèrent à partir d'elle quand vous appuyez sur Done."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ düzenleniyor. Her değişiklik düzenlenmiş bir kopya yazar — asıl dosya asla değiştirilmez. Done'a bastığınızda takım yolları ondan yeniden üretilir."
          }
        }
      }
    },
    "Effective cutting diameter at depth — for a V-bit, tip + 2 × |depth| × tan(angle ÷ 2). Everything is offset and cleared by this width." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diámetro de corte efectivo a la profundidad; para una fresa en V, punta + 2 × |profundidad| × tan(ángulo ÷ 2). Todo se desplaza y despeja con este ancho."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diamètre de coupe effectif en profondeur — pour une fraise en V, pointe + 2 × |profondeur| × tan(angle ÷ 2). Tout est décalé et dégagé de cette largeur."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Derinlikteki etkin kesme çapı — V uç için uç + 2 × |derinlik| × tan(açı ÷ 2). Her şey bu genişlikte ötelenir ve temizlenir."
          }
        }
      }
    },
    "Either (shortest path)" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquiera (camino más corto)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indifférent (chemin le plus court)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fark etmez (en kısa yol)"
          }
        }
      }
    },
    "Elapsed · remaining (estimated from the program's feed rates)" : {
