    "Delete the selected tool. Layers set from it keep their values.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer l'outil sélectionné. Les couches réglées d'après lui gardent leurs valeurs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borrar la herramienta seleccionada. Las capas configuradas con ella conservan sus valores."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili takımı sil. Ondan ayarlanmış katmanlar değerlerini korur."
          }
        }
      }
    },
