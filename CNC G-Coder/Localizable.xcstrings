    "No guides — add one through the centre of a selection, or drag one out of a ruler": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun guide — ajoutez-en un par le centre d'une sélection, ou tirez-en un d'une règle"
          }
        },
        "es": {
