    "Position may be lost — Home recommended. Unlock keeps the position as-is (FluidNC also marks the axes homed).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La position peut être perdue — Home recommandé. Unlock garde la position telle quelle (FluidNC marque aussi les axes comme référencés)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La posición puede haberse perdido: se recomienda Home. Unlock conserva la posición tal cual (FluidNC también marca los ejes como referenciados)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum kaybolmuş olabilir — Home önerilir. Unlock konumu olduğu gibi tutar (FluidNC eksenleri home'lanmış olarak da işaretler)."
          }
        }
      }
    },
