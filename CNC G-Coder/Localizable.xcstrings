    },
    "Go to work zero: rapid up to the safe work Z, then to work X0 Y0": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aller au zéro pièce : rapide jusqu'au Z pièce sûr, puis à X0 Y0 pièce"
