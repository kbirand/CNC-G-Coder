    "V-bits cut wider the deeper they go; their cutting width is worked out from tip, angle and depth." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fresas en V cortan más ancho cuanto más profundo; su ancho de corte se calcula a partir de punta, ángulo y profundidad."
          }
        },
        "fr" : {
          "stringUnit" : {
