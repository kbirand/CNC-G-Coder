    "Isolation width" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancho de aislamiento"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Largeur d'isolation"
          }
        },
        "tr" : {
          "stringUnit" : {
