            "state": "translated",
            "value": "%@  ·  ▶ çalışıyor"
          }
        }
      }
    },
    "%@ Each drill file becomes its own program — change bits at the M0 pauses.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Chaque fichier de perçage devient son propre programme — changez de foret aux pauses M0."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Cada archivo de taladrado se convierte en su propio programa: cambie de broca en las pausas M0."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Her delme dosyası kendi programı olur — M0 duraklamalarında ucu değiştirin."
          }
        }
      }
    },
    "%@ Off: every hole in this file is drilled. Turn this on to mill holes larger than any drill you own.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Désactivé : chaque trou de ce fichier est percé. Activez pour fraiser les trous plus grands que tous vos forets."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Desactivado: cada agujero de este archivo se taladra. Actívelo para fresar agujeros mayores que cualquier broca que tenga."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Kapalı: bu dosyadaki her delik delinir. Sahip olduğunuz tüm matkaplardan büyük delikleri frezelemek için açın."
          }
        }
      }
    },
