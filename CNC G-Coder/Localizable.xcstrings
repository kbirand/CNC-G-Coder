          }
        }
      }
    },
    "Top printed legend (.GTO) — designators, outlines, text. Becomes top-silkscreen.ngc when Silkscreen is set to Engrave.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Légende imprimée supérieure (.GTO) — repères, contours, texte. Devient top-silkscreen.ngc quand Silkscreen est réglé sur Engrave."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leyenda impresa superior (.GTO): designadores, contornos, texto. Se convierte en top-silkscreen.ngc cuando Silkscreen está en Engrave."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üst basılı yazılar (.GTO) — referans adları, hatlar, metin. Silkscreen, Engrave olarak ayarlandığında top-silkscreen.ngc olur."
          }
        }
      }
    },
    "Top silkscreen": {
      "localizations": {
