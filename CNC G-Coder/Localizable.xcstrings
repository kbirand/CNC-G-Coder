      }
    },
    "Isolation width": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Largeur d'isolation"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancho de aislamiento"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzolasyon genişliği"
          }
        }
      }
    },
    "Isolation width %1$@ mm, safe Z %2$@ mm and plunge clearance %3$@ mm come from the project settings. A V-bit's cut width is worked out per row from its tip and angle, as in production.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Largeur d'isolation %1$@ mm, Z de sécurité %2$@ mm et garde de plongée %3$@ mm viennent des réglages du projet. La largeur de coupe d'une fraise en V est calculée par ligne d'après sa pointe et son angle, comme en production."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ancho de aislamiento %1$@ mm, la Z segura %2$@ mm y la holgura de inmersión %3$@ mm vienen de los ajustes del proyecto. El ancho de corte de una fresa en V se calcula por fila a partir de su punta y ángulo, como en producción."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzolasyon genişliği %1$@ mm, güvenli Z %2$@ mm ve dalma boşluğu %3$@ mm proje ayarlarından gelir. V ucun kesme genişliği üretimdeki gibi her satır için ucundan ve açısından hesaplanır."
          }
        }
      }
    },
    "Isolation width %@ mm, safe Z %@ mm and plunge clearance %@ mm come from the project settings. A V-bit's cut width is worked out per row from its tip and angle, as in production.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Largeur d'isolation %1$@ mm, Z de sécurité %2$@ mm et garde de plongée %3$@ mm viennent des réglages du projet. La largeur de coupe d'une fraise en V est calculée par ligne d'après sa pointe et son angle, comme en production."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ancho de aislamiento %1$@ mm, la Z segura %2$@ mm y la holgura de inmersión %3$@ mm vienen de los ajustes del proyecto. El ancho de corte de una fresa en V se calcula por fila a partir de su punta y ángulo, como en producción."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzolasyon genişliği %1$@ mm, güvenli Z %2$@ mm ve dalma boşluğu %3$@ mm proje ayarlarından gelir. V ucun kesme genişliği üretimdeki gibi her satır için ucundan ve açısından hesaplanır."
          }
        }
      }
    },
