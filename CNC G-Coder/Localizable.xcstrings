    "Align moves shapes to the edges or centres of the selection's box; distribute spaces them with equal gaps.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aligner déplace les formes sur les bords ou centres du cadre de sélection ; distribuer les espace à intervalles égaux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alinear mueve las formas a los bordes o centros del recuadro de selección; distribuir las separa con huecos iguales."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hizala, şekilleri seçim kutusunun kenarlarına ya da merkezlerine taşır; dağıt, aralarına eşit boşluk bırakır."
          }
        }
      }
    },
    "Align the selected shapes' edges or centres to the selection's bounding box.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aligner les bords ou centres des formes sélectionnées sur le cadre de la sélection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alinear los bordes o centros de las formas seleccionadas con el recuadro de la selección."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili şekillerin kenarlarını ya da merkezlerini seçimin sınır kutusuna hizalar."
          }
        }
      }
    },
    "All Layers Overlay": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Superposer toutes les couches"
          }
        },
        "es": {
