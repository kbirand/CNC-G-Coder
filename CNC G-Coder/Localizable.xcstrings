            "state": "translated",
            "value": "Başlatma; iş olduğu gibi kalır"
          }
        }
      }
    },
    "Don't Save": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne pas enregistrer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No guardar"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydetme"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminé"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hecho"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitti"
          }
        }
      }
    },
    "Downward feed while drilling.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avance de descente pendant le perçage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avance descendente al taladrar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Delerken aşağı ilerleme."
          }
        }
      }
    },
    "Downward feed while drilling. Carbide PCB drills like fast RPM and moderate feed; 60–120 mm/min is typical.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avance de descente pendant le perçage. Les forets carbure pour PCB aiment une vitesse de rotation élevée et une avance modérée ; 60–120 mm/min est typique."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avance descendente al taladrar. A las brocas de carburo para PCB les gustan muchas rpm y un avance moderado; 60–120 mm/min es lo típico."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Delerken aşağı ilerleme. Karbür PCB matkapları yüksek devir ve orta ilerleme sever; 60–120 mm/dk tipiktir."
          }
        }
      }
    },
    "Drag out of a ruler to place a guide, drag a guide to move it, and drop it back outside the drawing area to remove it. Guides snap to ruler ticks and hold machine positions, so they stay put through zoom, pan and layer changes.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glissez depuis une règle pour placer un guide, glissez un guide pour le déplacer, et déposez-le hors de la zone de dessin pour le retirer. Les guides s'accrochent aux graduations et gardent des positions machine ; ils restent en place malgré zoom, déplacement et changements de couche."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastre desde una regla para colocar una guía, arrastre una guía para moverla y suéltela fuera del área de dibujo para quitarla. Las guías se ajustan a las marcas de la regla y guardan posiciones de máquina, así que no se mueven con zoom, desplazamiento ni cambios de capa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kılavuz yerleştirmek için bir cetvelden sürükleyin, taşımak için kılavuzu sürükleyin, kaldırmak için çizim alanının dışına bırakın. Kılavuzlar cetvel çizgilerine yapışır ve makine konumlarını tutar; yakınlaştırma, kaydırma ve katman değişimlerinde yerinde kalırlar."
          }
        }
      }
    },
    "Drag the vertex handles in the view to reshape the line.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glissez les poignées de sommet dans la vue pour remodeler la ligne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastre los tiradores de vértice en la vista para cambiar la línea."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çizgiyi yeniden biçimlendirmek için görünümdeki köşe tutamaçlarını sürükleyin."
          }
        }
      }
    },
    "Drag to reorder the buttons of the position panel; − removes one, + adds a built-in action or a macro at the end.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour réordonner les boutons du panneau de position ; − en retire un, + ajoute une action intégrée ou une macro à la fin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastre para reordenar los botones del panel de posición; − quita uno, + añade una acción integrada o una macro al final."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum panelinin düğmelerini sürükleyerek yeniden sıralayın; − birini kaldırır, + sona bir yerleşik eylem ya da makro ekler."
          }
        }
      }
    },
    "Draw lines, rectangles, circles and text on a layer of your own and machine them with a tool you choose.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessinez lignes, rectangles, cercles et texte sur une couche à vous et usinez-les avec l'outil de votre choix."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuje líneas, rectángulos, círculos y texto en una capa propia y mecanícelos con la herramienta que elija."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi katmanınıza çizgi, dikdörtgen, daire ve metin çizin ve seçtiğiniz bir takımla işleyin."
          }
        }
      }
    },
    "Drawing on %1$@ (%2$@ side). Pick another program in the sidebar to leave the editor.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessin sur %1$@ (face %2$@). Choisissez un autre programme dans la barre latérale pour quitter l'éditeur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibujando en %1$@ (cara %2$@). Elija otro programa en la barra lateral para salir del editor."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ üzerinde çiziliyor (%2$@ taraf). Düzenleyiciden çıkmak için kenar çubuğundan başka bir program seçin."
          }
        }
      }
    },
    "Drawing on %@ (%@ side). Pick another program in the sidebar to leave the editor.": {
      "localizations": {
        "fr": {
