            "state" : "translated",
            "value" : "İşi bırak: reset, iş mili kapalı. Send from line… ile daha sonra sürdürülebilir."
          }
        }
      }
    },
    "About the centre. Resize handles are hidden while rotated." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respecto al centro. Los tiradores de redimensión se ocultan mientras está rotada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autour du centre. Les poignées de redimensionnement sont masquées quand la forme est tournée."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merkez etrafında. Döndürülmüşken boyutlandırma tutamaçları gizlenir."
          }
        }
