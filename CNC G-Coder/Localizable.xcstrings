    "Edit this file in the preview: track widths, pad and hole sizes, moving or deleting features.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifier ce fichier dans l'aperçu : largeurs de pistes, tailles de pastilles et de trous, déplacement ou suppression d'éléments."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Editar este archivo en la vista previa: anchos de pista, tamaños de pads y agujeros, mover o borrar elementos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dosyayı önizlemede düzenleyin: iz genişlikleri, pad ve delik boyutları, öğeleri taşıma ya da silme."
          }
        }
      }
    },
    "Edited": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifié"
          }
        },
        "es": {
