    "Active input pins (Pn:) — P = probe closed, X/Y/Z = limit switches, D = door, H = hold, R = reset, S = start" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entradas activas (Pn:) — P = palpador cerrado, X/Y/Z = finales de carrera, D = puerta, H = hold, R = reset, S = start"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrées actives (Pn:) — P = palpeur fermé, X/Y/Z = fins de course, D = porte, H = hold, R = reset, S = start"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkin giriş pinleri (Pn:) — P = prob kapalı, X/Y/Z = sınır anahtarları, D = kapı, H = hold, R = reset, S = start"
          }
        }
      }
    },
    "Add" : {
      "localizations" : {
