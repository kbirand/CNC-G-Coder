          }
        }
      }
    },
    "Click to place X0 Y0 — snaps to corners, centre and drill holes": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez pour placer X0 Y0 — s'accroche aux coins, au centre et aux trous"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haga clic para colocar X0 Y0; se ajusta a esquinas, centro y agujeros"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "X0 Y0'ı yerleştirmek için tıklayın — köşelere, merkeze ve deliklere yapışır"
          }
        }
      }
    },
    "Click to set the work %@ of the current position": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez pour définir le %@ pièce de la position courante"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haga clic para fijar el %@ de trabajo de la posición actual"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçerli konumun iş %@ değerini ayarlamak için tıklayın"
