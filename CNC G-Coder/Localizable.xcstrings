    "Select Similar: every track of the same width, pad of the same aperture, or hole of the same size as the selection.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionner les semblables : chaque piste de même largeur, pastille de même ouverture ou trou de même taille que la sélection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccionar similares: cada pista del mismo ancho, pad de la misma apertura o agujero del mismo tamaño que la selección."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Benzerleri Seç: seçimle aynı genişlikteki her iz, aynı apertürlü pad ya da aynı boyuttaki delik."
          }
        }
      }
    },
    "Select a layer in the player below to see its Z profile.": {
