            "value": "Démo"
          }
        }
      }
    },
    "Depth": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profondeur"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Profundidad"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Derinlik"
          }
        }
      }
    },
    "Depth added per turn of the spiral. 0.3–0.6 mm for a 2 mm end mill in FR4. The depth is spread evenly, so the real step may be a little smaller.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profondeur ajoutée par tour de spirale. 0,3–0,6 mm pour une fraise de 2 mm dans du FR4. La profondeur est répartie uniformément, le pas réel peut donc être un peu plus petit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Profundidad añadida por vuelta de la espiral. 0,3–0,6 mm para una fresa de 2 mm en FR4. La profundidad se reparte uniformemente, así que el paso real puede ser algo menor."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiralin her turunda eklenen derinlik. FR4'te 2 mm parmak freze için 0,3–0,6 mm. Derinlik eşit dağıtılır; gerçek adım biraz daha küçük olabilir."
          }
        }
      }
    },
    "Depth per pass": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profondeur par passe"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Profundidad por pasada"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paso derinliği"
          }
        }
      }
    },
    "Depth removed per lap around the outline. 0.3–0.5 mm for a 1 mm end mill in FR laminate.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profondeur enlevée par tour autour du contour. 0,3–0,5 mm pour une fraise de 1 mm dans du stratifié FR."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Profundidad eliminada por vuelta alrededor del contorno. 0,3–0,5 mm para una fresa de 1 mm en laminado FR."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dış hat çevresindeki her turda kaldırılan derinlik. FR laminatta 1 mm parmak freze için 0,3–0,5 mm."
          }
        }
      }
    },
    "Deselect (Esc)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désélectionner (Échap)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deseleccionar (Esc)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçimi kaldır (Esc)"
          }
        }
      }
    },
    "Design coordinates of the Gerber file (not the machine origin). Moves the whole object.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coordonnées de conception du fichier Gerber (pas l'origine machine). Déplace tout l'objet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coordenadas de diseño del archivo Gerber (no el origen de máquina). Mueve todo el objeto."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerber dosyasının tasarım koordinatları (makine başlangıcı değil). Tüm nesneyi taşır."
          }
        }
      }
    },
    "Design coordinates of the drill file (not the machine origin).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coordonnées de conception du fichier de perçage (pas l'origine machine)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coordenadas de diseño del archivo de taladrado (no el origen de máquina)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Delme dosyasının tasarım koordinatları (makine başlangıcı değil)."
          }
        }
      }
    },
    "Design origin (no zeroing)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Origine du dessin (sans zéro)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Origen del diseño (sin cero)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasarım başlangıcı (sıfırlama yok)"
          }
        }
      }
    },
    "Destination": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Destino"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedef"
          }
        }
      }
    },
    "Diameter": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diamètre"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Diámetro"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çap"
          }
        }
      }
    },
    "Diameter of the end mill (e.g. a 2 mm 2-flute corn bit). The circle is offset inward by half of it, so the hole comes out at its designed size.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diamètre de la fraise (p. ex. une fraise corn de 2 mm à 2 dents). Le cercle est décalé vers l'intérieur de sa moitié, le trou sort donc à sa taille de conception."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Diámetro de la fresa (p. ej. una fresa corn de 2 mm y 2 filos). El círculo se desplaza hacia dentro la mitad, así que el agujero sale a su tamaño de diseño."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parmak frezenin çapı (örn. 2 mm 2 ağızlı mısır freze). Daire yarısı kadar içe ötelenir; böylece delik tasarlanan boyutta çıkar."
          }
        }
      }
    },
    "Diameter of the end mill that cuts the board outline. The path is offset outward by half of this so the finished board matches the designed outline.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diamètre de la fraise qui découpe le contour. Le chemin est décalé vers l'extérieur de sa moitié pour que la carte finie corresponde au contour dessiné."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Diámetro de la fresa que corta el contorno de la placa. El trazado se desplaza hacia fuera la mitad para que la placa terminada coincida con el contorno diseñado."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kart dış hattını kesen parmak frezenin çapı. Yol bunun yarısı kadar dışa ötelenir; böylece bitmiş kart tasarlanan dış hatla eşleşir."
          }
        }
      }
    },
    "Diameter of the holes you place. Change one later in the sidebar like any circle.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diamètre des trous que vous placez. Modifiez-en un plus tard dans la barre latérale comme tout cercle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Diámetro de los agujeros que coloca. Cambie uno después en la barra lateral como cualquier círculo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerleştirdiğiniz deliklerin çapı. Daha sonra kenar çubuğunda herhangi bir daire gibi değiştirin."
          }
        }
      }
    },
    "Direction the cutter travels relative to its rotation, for isolation, outline, mask and legend milling. Any: whichever gives the shortest path. Climb: cleaner edges on rigid machines with little backlash. Conventional: safer on hobby machines with backlash. Fixing a direction switches off 2-opt path shortening, so programs get a little longer.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sens de déplacement de la fraise par rapport à sa rotation, pour l'isolation, le contour, le vernis et la légende. Indifférent : celui qui donne le chemin le plus court. Avalant : bords plus propres sur les machines rigides à faible jeu. Opposition : plus sûr sur les machines amateur avec du jeu. Fixer un sens désactive le raccourcissement 2-opt, les programmes s'allongent donc un peu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dirección en que avanza la fresa respecto a su giro, para aislamiento, contorno, máscara y leyenda. Cualquiera: la que dé el camino más corto. Concordante: bordes más limpios en máquinas rígidas con poca holgura. Discordante: más seguro en máquinas de aficionado con holgura. Fijar una dirección desactiva el acortamiento de caminos 2-opt, así que los programas se alargan un poco."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Frezenin dönüşüne göre ilerleme yönü; izolasyon, dış hat, maske ve yazı frezelemesi için. Fark etmez: hangisi en kısa yolu veriyorsa. Eş yönlü: boşluğu az, rijit makinelerde daha temiz kenarlar. Zıt yönlü: boşluklu hobi makinelerinde daha güvenli. Bir yön sabitlemek 2-opt yol kısaltmayı kapatır; programlar biraz uzar."
          }
        }
      }
    },
    "Direction the spindle turns. Almost every bit cuts clockwise; pick counter-clockwise only for left-hand tools.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sens de rotation de la broche. Presque toutes les fraises coupent en sens horaire ; choisissez l'antihoraire uniquement pour les outils à gauche."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentido de giro del husillo. Casi todas las fresas cortan en sentido horario; elija antihorario solo para herramientas a izquierdas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İş milinin dönüş yönü. Neredeyse her uç saat yönünde keser; saat yönünün tersini yalnızca sol takımlar için seçin."
          }
        }
      }
    },
    "Discard the changes": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abandonner les modifications"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descartar los cambios"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişiklikleri at"
          }
        }
      }
    },
    "Disconnect": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnecter"
          }
        },
        "es": {
