    "Send first shows which layer is about to be milled — side, tool, depth, time — and streams on Start": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Send montre d'abord quelle couche va être fraisée — face, outil, profondeur, durée — et diffuse sur Start"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Send muestra primero qué capa se va a fresar — cara, herramienta, profundidad, tiempo — y transmite con Start"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Send önce hangi katmanın frezeleneceğini gösterir — yüz, takım, derinlik, süre — ve Start ile akıtır"
          }
        }
      }
    },
    "Send from line": {
      "localizations": {
