    "Clearances added to every size, separated by spaces: each becomes a column. Negative values test a tighter fit." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Holguras añadidas a cada tamaño, separadas por espacios: cada una es una columna. Los valores negativos prueban un ajuste más apretado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeux ajoutés à chaque taille, séparés par des espaces : chacun devient une colonne. Les valeurs négatives testent un ajustement plus serré."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her boyuta eklenen boşluklar, boşlukla ayrılmış: her biri bir sütun olur. Negatif değerler daha sıkı bir uyumu test eder."
          }
        }
      }
    },
