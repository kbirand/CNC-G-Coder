    "Cut depth": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profondeur de coupe"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Profundidad de corte"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kesme derinliği"
          }
        }
      }
    },
    "Cut depth over the tabs. Tab thickness = board bottom − this value (e.g. −0.8 on 1.6 mm stock leaves 0.8 mm tabs).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profondeur de coupe au-dessus des languettes. Épaisseur de languette = dessous de carte − cette valeur (p. ex. −0,8 sur 1,6 mm laisse des languettes de 0,8 mm)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Profundidad de corte sobre las pestañas. Grosor de pestaña = fondo de placa − este valor (p. ej. −0,8 en material de 1,6 mm deja pestañas de 0,8 mm)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tırnakların üstündeki kesme derinliği. Tırnak kalınlığı = kart altı − bu değer (örn. 1,6 mm malzemede −0,8, 0,8 mm'lik tırnaklar bırakır)."
          }
        }
      }
    },
    "Cut depth sweep": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayage de profondeur"
          }
        },
