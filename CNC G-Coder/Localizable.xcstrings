    "Include every ? poll and <…> report in the Console tab — useful for diagnosing, noisy otherwise" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluir cada sondeo ? e informe <…> en la pestaña Console: útil para diagnosticar, ruidoso en otro caso"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclure chaque interrogation ? et rapport <…> dans l'onglet Console — utile pour diagnostiquer, bruyant sinon"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her ? sorgusunu ve <…> raporunu Console sekmesine dahil et — tanılama için yararlı, yoksa gürültülü"
          }
        }
      }
    },
    "Include the ? polls and <…> reports (5 per second)" : {
      "localizations" : {
