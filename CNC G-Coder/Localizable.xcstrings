      }
    },
    "Grid doesn't fit this board — patches need at least ≈8.5 × 8 mm each, with room for a full cut around every trace. Reduce steps or enlarge the board (Suggest fills in what fits)." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cuadrícula no cabe en esta placa: cada parche necesita al menos ≈8,5 × 8 mm, con espacio para un corte completo alrededor de cada pista. Reduzca los pasos o agrande la placa (Sugerir rellena lo que cabe)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La grille ne tient pas sur cette carte — chaque zone demande au moins ≈8,5 × 8 mm, avec la place d'une coupe complète autour de chaque piste. Réduisez les pas ou agrandissez la carte (Suggérer remplit ce qui tient)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izgara bu karta sığmıyor — her yama en az ≈8,5 × 8 mm ve her izin çevresinde tam bir kesim için yer gerektirir. Adımları azaltın ya da kartı büyütün (Öner, sığanı doldurur)."
          }
        }
      }
    },
    "Grid is limited to %1$lld feeds × %2$lld depths." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cuadrícula se limita a %1$lld avances × %2$lld profundidades."
          }
        },
        "fr" : {
