          }
        }
      }
    },
    "Allow while a program runs": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser pendant un programme"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir mientras se ejecuta un programa"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Program çalışırken izin ver"
          }
        }
      }
    },
    "Almost every bit cuts clockwise; counter-clockwise is for left-hand tools.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Presque toutes les fraises coupent en sens horaire ; l'antihoraire est pour les outils à gauche."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Casi todas las fresas cortan en sentido horario; el antihorario es para herramientas a izquierdas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neredeyse her uç saat yönünde keser; saat yönünün tersi sol takımlar içindir."
          }
        }
      }
    },
    "Already the %@ file": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjà le fichier %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya es el archivo de %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaten %@ dosyası"
          }
        }
      }
    },
    "Also run $CD=<config file> after Apply, which writes the running configuration to that file; off, the new steps/mm last until the controller reboots": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécute aussi $CD=<fichier de config> après Apply, qui écrit la configuration en cours dans ce fichier ; désactivé, les nouveaux pas/mm durent jusqu'au redémarrage du contrôleur"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecutar también $CD=<archivo de config> tras Apply, que escribe la configuración en ejecución en ese archivo; desactivado, los nuevos pasos/mm duran hasta que el controlador se reinicie"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply'dan sonra çalışan yapılandırmayı o dosyaya yazan $CD=<yapılandırma dosyası> komutunu da çalıştır; kapalıyken yeni adım/mm denetleyici yeniden başlayana kadar sürer"
          }
        }
      }
    },
