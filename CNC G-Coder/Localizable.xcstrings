    },
    "Choose a project folder and refresh the preview.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un dossier de projet et rafraîchissez l'aperçu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija una carpeta de proyecto y actualice la vista previa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir proje klasörü seçin ve önizlemeyi yenileyin."
          }
        }
      }
    },
    "Choose a tool library exported from CNC G-Coder (.json) or a FlatCAM Tools Database export (.TXT).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une bibliothèque d'outils exportée par CNC G-Coder (.json) ou un export de base d'outils FlatCAM (.TXT)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija una biblioteca de herramientas exportada desde CNC G-Coder (.json) o una exportación de la base de herramientas de FlatCAM (.TXT)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CNC G-Coder'dan dışa aktarılmış bir takım kitaplığı (.json) ya da bir FlatCAM Tools Database dışa aktarımı (.TXT) seçin."
          }
        }
      }
    },
    "Choose the Gerber export folder (EasyEDA or KiCad: Gerber + drill files).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez le dossier d'export Gerber (EasyEDA ou KiCad : fichiers Gerber + perçage)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija la carpeta de exportación Gerber (EasyEDA o KiCad: archivos Gerber + taladrado)."
          }
        },
        "tr": {
