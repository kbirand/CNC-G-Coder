          }
        }
      }
    },
    "Edited in CNC G-Coder (from %@); the original file is unchanged.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifié dans CNC G-Coder (depuis %@) ; le fichier d'origine est inchangé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Editado en CNC G-Coder (desde %@); el archivo original no ha cambiado."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CNC G-Coder'da düzenlendi (%@ kaynağından); asıl dosya değişmedi."
          }
        }
      }
    },
    "Edited in this session — Undo steps back through the edits; saving the project keeps them.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifié dans cette session — Annuler revient sur les modifications ; enregistrer le projet les conserve."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Editado en esta sesión: Deshacer recorre las ediciones hacia atrás; guardar el proyecto las conserva."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu oturumda düzenlendi — Geri Al düzenlemeleri geri alır; projeyi kaydetmek onları korur."
          }
        }
      }
    },
    "Editing %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modification de %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Editando %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ düzenleniyor"
          }
        }
      }
    },
    "Editing %@. Each change writes an edited copy — the original file is never modified. The toolpaths regenerate from it when you press Done.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modification de %@. Chaque changement écrit une copie modifiée — le fichier d'origine n'est jamais touché. Les parcours se régénèrent à partir d'elle quand vous appuyez sur Done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Editando %@. Cada cambio escribe una copia editada; el archivo original nunca se modifica. Las trayectorias se regeneran a partir de ella al pulsar Done."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ düzenleniyor. Her değişiklik düzenlenmiş bir kopya yazar — asıl dosya asla değiştirilmez. Done'a bastığınızda takım yolları ondan yeniden üretilir."
          }
        }
      }
    },
    "Edit…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifier…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Editar…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzenle…"
          }
        }
      }
    },
    "Effective cutting diameter at depth — for a V-bit, tip + 2 × |depth| × tan(angle ÷ 2). Everything is offset and cleared by this width.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diamètre de coupe effectif en profondeur — pour une fraise en V, pointe + 2 × |profondeur| × tan(angle ÷ 2). Tout est décalé et dégagé de cette largeur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Diámetro de corte efectivo a la profundidad; para una fresa en V, punta + 2 × |profundidad| × tan(ángulo ÷ 2). Todo se desplaza y despeja con este ancho."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Derinlikteki etkin kesme çapı — V uç için uç + 2 × |derinlik| × tan(açı ÷ 2). Her şey bu genişlikte ötelenir ve temizlenir."
          }
        }
      }
    },
    "Either (shortest path)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indifférent (chemin le plus court)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquiera (camino más corto)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fark etmez (en kısa yol)"
          }
        }
      }
    },
    "Elapsed · remaining (feed-rate estimate, scaled by the pace observed so far)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écoulé · restant (estimation par les vitesses d'avance, mise à l'échelle du rythme observé)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcurrido · restante (estimación por velocidades de avance, escalada al ritmo observado)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçen · kalan (ilerleme hızları tahmini, şimdiye kadarki gözlenen tempoya göre ölçeklenir)"
          }
        }
      }
    },
    "Emergency Stop": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêt d'urgence"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parada de emergencia"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Acil Durdurma"
          }
        }
      }
    },
    "Emergency stop": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêt d'urgence"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parada de emergencia"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Acil durdurma"
          }
        }
      }
    },
    "Emergency stop (⇧⌘.): jog cancel, feed hold and reset at once — the position is lost if the machine was moving": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêt d'urgence (⇧⌘.) : annulation du jog, feed hold et reset d'un coup — la position est perdue si la machine bougeait"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parada de emergencia (⇧⌘.): cancelar jog, feed hold y reset a la vez; la posición se pierde si la máquina se movía"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Acil durdurma (⇧⌘.): jog iptali, feed hold ve reset bir arada — makine hareket ediyorduysa konum kaybolur"
          }
        }
      }
    },
    "Empty the console view — the connection itself is untouched": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vider la console — la connexion elle-même n'est pas touchée"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaciar la vista de consola; la conexión no se toca"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konsol görünümünü boşalt — bağlantının kendisine dokunulmaz"
          }
        }
      }
    },
    "Empty — draw with the tools above the preview": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vide — dessinez avec les outils au-dessus de l'aperçu"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vacía: dibuje con las herramientas sobre la vista previa"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boş — önizlemenin üstündeki araçlarla çizin"
          }
        }
      }
    },
    "End Z": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Z de fin"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Z final"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitiş Z"
          }
        }
      }
    },
    "End mill used to clear mask openings. Openings SMALLER than this cannot be pocketed and are skipped — use a bit no larger than your smallest pad opening (check the Log for warnings).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fraise utilisée pour dégager les ouvertures du vernis. Les ouvertures PLUS PETITES qu'elle ne peuvent pas être évidées et sont ignorées — utilisez une fraise pas plus grande que votre plus petite ouverture de pastille (vérifiez les avertissements dans le Log)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fresa usada para despejar las aberturas de máscara. Las aberturas MENORES que ella no pueden vaciarse y se omiten; use una fresa no mayor que su abertura de pad más pequeña (revise los avisos en el Log)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maske açıklıklarını temizlemek için kullanılan parmak freze. Bundan KÜÇÜK açıklıklar boşaltılamaz ve atlanır — en küçük pad açıklığınızdan büyük olmayan bir uç kullanın (uyarılar için Log'a bakın)."
          }
        }
      }
    },
    "End mill Ø %1$@ mm · flutes %2$@ mm · shank %3$@ mm": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fraise Ø %1$@ mm · goujures %2$@ mm · queue %3$@ mm"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fresa Ø %1$@ mm · filos %2$@ mm · vástago %3$@ mm"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parmak freze Ø %1$@ mm · ağız %2$@ mm · sap %3$@ mm"
          }
        }
      }
    },
    "End mill Ø %@ mm · flutes %@ mm · shank %@ mm": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fraise Ø %1$@ mm · goujures %2$@ mm · queue %3$@ mm"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fresa Ø %1$@ mm · filos %2$@ mm · vástago %3$@ mm"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parmak freze Ø %1$@ mm · ağız %2$@ mm · sap %3$@ mm"
          }
        }
      }
    },
    "Engine": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moteur"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Motor"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Motor"
          }
        }
      }
    },
    "English, French, Spanish and Turkish. Changing it takes effect at the next launch.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anglais, français, espagnol et turc. Le changement prend effet au prochain lancement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inglés, francés, español y turco. El cambio surte efecto en el siguiente arranque."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İngilizce, Fransızca, İspanyolca ve Türkçe. Değişiklik bir sonraki açılışta etkili olur."
          }
        }
      }
    },
    "Engrave": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Graver"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabar"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kazı"
          }
        }
      }
    },
    "Engrave centreline": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Graver la ligne centrale"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabar línea central"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merkez çizgisini kazı"
          }
        }
      }
    },
    "Engrave: the tool follows the drawn line itself. Cut outside / inside: closed shapes are offset by half the tool so what you drew is the size that comes out — outside for a part you keep, inside for a hole. Open lines are always engraved.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Graver : l'outil suit la ligne dessinée elle-même. Couper à l'extérieur / l'intérieur : les formes fermées sont décalées d'un demi-outil pour que ce que vous avez dessiné soit la taille obtenue — extérieur pour une pièce conservée, intérieur pour un trou. Les lignes ouvertes sont toujours gravées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabar: la herramienta sigue la propia línea dibujada. Cortar por fuera / por dentro: las formas cerradas se desplazan media herramienta para que lo dibujado sea el tamaño resultante; fuera para una pieza que se conserva, dentro para un agujero. Las líneas abiertas siempre se graban."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kazı: takım çizilen çizginin kendisini izler. Dıştan / içten kes: kapalı şekiller yarım takım ötelenir; böylece çizdiğiniz, çıkan boyut olur — sakladığınız parça için dıştan, delik için içten. Açık çizgiler her zaman kazınır."
          }
        }
      }
    },
    "Engraving": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravure"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabado"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kazıma"
          }
        }
      }
    },
    "Error: %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erreur : %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hata: %@"
          }
        }
      }
    },
    "Etch depth": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profondeur de gravure"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Profundidad de grabado"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aşındırma derinliği"
          }
        }
      }
    },
    "Every circle is drilled at its centre with the drill below, pecking by Depth per pass. Other shapes are ignored. Place holes with the Hole tool.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque cercle est percé en son centre avec le foret ci-dessous, par débourrage selon Profondeur par passe. Les autres formes sont ignorées. Placez les trous avec l'outil Trou."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada círculo se taladra en su centro con la broca de abajo, picoteando según Profundidad por pasada. Las demás formas se ignoran. Coloque agujeros con la herramienta Agujero."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her daire, aşağıdaki matkapla merkezinden, Paso derinliği kadar gagalayarak delinir. Diğer şekiller yok sayılır. Delikleri Delik aracıyla yerleştirin."
          }
        }
      }
    },
    "Every closed contour runs on past its start by this much, so the spot where the loop closes is cut twice and no copper sliver is left there. 0 = off. FlatCAM's default is 0.1–0.2 mm.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque contour fermé dépasse son départ de cette longueur, l'endroit où la boucle se ferme est donc coupé deux fois et aucune bavure de cuivre n'y reste. 0 = désactivé. La valeur par défaut de FlatCAM est 0,1–0,2 mm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada contorno cerrado sigue más allá de su inicio esta distancia, así que el punto donde se cierra el bucle se corta dos veces y no queda rebaba de cobre. 0 = desactivado. El valor por defecto de FlatCAM es 0,1–0,2 mm."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her kapalı kontur başlangıcını bu kadar geçer; böylece döngünün kapandığı yer iki kez kesilir ve orada bakır kıymığı kalmaz. 0 = kapalı. FlatCAM varsayılanı 0,1–0,2 mm'dir."
          }
        }
      }
    },
    "Every track of the same width, pad of the same aperture, or hole of the same size.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque piste de même largeur, pastille de même ouverture ou trou de même taille."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada pista del mismo ancho, pad de la misma apertura o agujero del mismo tamaño."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı genişlikteki her iz, aynı apertürlü pad ya da aynı boyuttaki delik."
          }
        }
      }
    },
    "Everything is in the grid. New Macro… adds another.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout est dans la grille. Nouvelle macro… en ajoute une."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo está en la rejilla. Nueva macro… añade otra."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şey ızgarada. Yeni Makro… bir tane daha ekler."
          }
        }
      }
    },
    "Excellon drill file. EasyEDA (and KiCad with separate PTH / NPTH files) splits holes into several files; each becomes its own drill program.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichier de perçage Excellon. EasyEDA (et KiCad avec des fichiers PTH / NPTH séparés) répartit les trous en plusieurs fichiers ; chacun devient son propre programme de perçage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivo de taladrado Excellon. EasyEDA (y KiCad con archivos PTH / NPTH separados) reparte los agujeros en varios archivos; cada uno se convierte en su propio programa de taladrado."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Excellon delme dosyası. EasyEDA (ve ayrı PTH / NPTH dosyalarıyla KiCad) delikleri birkaç dosyaya böler; her biri kendi delme programı olur."
          }
        }
      }
    },
    "Export %@.ngc…": {
      "localizations": {
