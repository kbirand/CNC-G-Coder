            "state": "translated",
            "value": "Kesme derinliği taraması"
          }
        }
      }
    },
    "Cut in several passes of at most this depth. 0 cuts the full depth in one pass.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couper en plusieurs passes d'au plus cette profondeur. 0 coupe toute la profondeur en une passe."
          }
        },
        "es": {
