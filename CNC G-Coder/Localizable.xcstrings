    "Stream this program to the connected controller from the Machine panel: connect, zero, probe, then Send.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diffuser ce programme au contrôleur connecté depuis le panneau Machine : connecter, zéro, palper, puis Envoyer."
          }
