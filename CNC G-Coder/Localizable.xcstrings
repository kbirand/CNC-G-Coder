          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Serigrafi"
          }
        }
      }
    },
    "Silkscreen layers are ignored.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les couches de sérigraphie sont ignorées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las capas de serigrafía se ignoran."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Serigrafi katmanları yok sayılır."
          }
        }
      }
    },
    "Simulated FluidNC with real-time motion. A PCB of set thickness lies on the bed (position and thickness in Settings → Machine) and work zero is preset on its top corner: the probe finds the board over it and the bed next to it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "FluidNC simulé avec mouvement en temps réel. Un PCB d'épaisseur réglée repose sur le plateau (position et épaisseur dans Settings → Machine) et le zéro pièce est prédéfini sur son coin supérieur : la sonde trouve la carte au-dessus d'elle et le plateau à côté."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "FluidNC simulado con movimiento en tiempo real. Un PCB de grosor configurable descansa sobre la mesa (posición y grosor en Settings → Machine) y el cero de trabajo está predefinido en su esquina superior: la sonda encuentra la placa sobre ella y la mesa al lado."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerçek zamanlı hareketli simüle FluidNC. Tablada, kalınlığı ayarlanabilir bir PCB durur (konum ve kalınlık Settings → Machine'de) ve iş sıfırı üst köşesine önceden ayarlıdır: prob kartın üzerinde kartı, yanında tablayı bulur."
          }
        }
      }
    },
    "Simulated FluidNC with real-time motion. Work zero and a probe surface are preset so the sample programs run.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "FluidNC simulé avec mouvement en temps réel. Le zéro pièce et une surface de palpage sont préréglés pour que les programmes d'exemple tournent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "FluidNC simulado con movimiento en tiempo real. El cero de trabajo y una superficie de palpado vienen preajustados para que los programas de ejemplo funcionen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerçek zamanlı hareketli simüle FluidNC. Örnek programlar çalışsın diye iş sıfırı ve bir prob yüzeyi önceden ayarlıdır."
          }
        }
      }
    },
    "Simulated board at": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Carte simulée à"
          }
        },
        "es": {
