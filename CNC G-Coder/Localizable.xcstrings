    "SIM" : {
      "comment" : "A label that indicates a simulator.",
      "isCommentAutoGenerated" : true
    },
    "Simulated FluidNC with real-time motion. Work zero and a probe surface are preset so the sample programs run." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FluidNC simulado con movimiento en tiempo real. El cero de trabajo y una superficie de palpado vienen preajustados para que los programas de ejemplo funcionen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FluidNC simulé avec mouvement en temps réel. Le zéro pièce et une surface de palpage sont préréglés pour que les programmes d'exemple tournent."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerçek zamanlı hareketli simüle FluidNC. Örnek programlar çalışsın diye iş sıfırı ve bir prob yüzeyi önceden ayarlıdır."
          }
        }
      }
    },
