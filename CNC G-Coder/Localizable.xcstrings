    "0 = bit on copper": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "0 = fraise sur le cuivre"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "0 = fresa sobre el cobre"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "0 = uç bakırın üstünde"
          }
        }
      }
    },
    "0 when the bit touches the copper itself (clip on the board); the plate's thickness when probing through a touch plate on the mask side.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "0 quand la fraise touche le cuivre lui-même (pince sur la carte) ; l'épaisseur de la plaque quand on palpe à travers une plaque de contact côté vernis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "0 cuando la fresa toca el propio cobre (pinza en la placa); el grosor de la placa al palpar a través de una placa de contacto por el lado de la máscara."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uç bakıra doğrudan değdiğinde 0 (kıskaç kartta); maske tarafında bir dokunma plakası üzerinden problarken plakanın kalınlığı."
          }
        }
      }
    },
    "1 % faster": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 % plus vite"
          }
        },
