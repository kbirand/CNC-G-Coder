            "value": "Preset'i Sil"
          }
        }
      }
    },
    "Delete Shapes": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer les formes"
          }
        },
        "es": {
