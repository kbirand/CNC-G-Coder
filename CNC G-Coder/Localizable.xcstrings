        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satırdan gönder"
          }
        }
      }
    },
    "Send from line %lld": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyer à partir de la ligne %lld"
          }
        },
