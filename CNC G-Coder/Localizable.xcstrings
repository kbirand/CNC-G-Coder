    "Toolpath: graphical preview with playback. G-code: the raw .ngc text, synced to playback. Log: the generator's output with per-step timings. Console: the conversation with the machine controller." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolpath: vista previa gráfica con reproducción. G-code: el texto .ngc en bruto, sincronizado con la reproducción. Log: la salida del generador con tiempos por paso. Console: la conversación con el controlador de la máquina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolpath : aperçu graphique avec lecture. G-code : le texte .ngc brut, synchronisé à la lecture. Log : la sortie du générateur avec les durées par étape. Console : la conversation avec le contrôleur de la machine."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolpath: oynatmalı grafik önizleme. G-code: oynatmayla eşzamanlı ham .ngc metni. Log: üreticinin adım başına süreli çıktısı. Console: makine denetleyicisiyle konuşma."
          }
        }
      }
    },
