        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takım kafasını izle: görünüm, hareket ederken ucu ortada tutar (görünümü sürüklemek bunu kapatır)"
          }
        }
      }
    },
    "Follow the tool head: the view keeps the tool centred while it moves (panning turns this off)" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguir al cabezal: la vista mantiene la herramienta centrada mientras se mueve (desplazar la vista lo desactiva)"
