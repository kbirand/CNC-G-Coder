    "Hole milling runs in the drilling program's pass, so it uses the drilling travel and tool-change heights." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El fresado de agujeros se ejecuta en la pasada del programa de taladrado, así que usa las alturas de desplazamiento y de cambio de herramienta del taladrado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fraisage de trous s'exécute dans la passe du programme de perçage ; il utilise donc les hauteurs de déplacement et de changement d'outil du perçage."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delik frezeleme delme programının pasosunda çalışır; bu yüzden delmenin hareket ve takım değiştirme yüksekliklerini kullanır."
          }
        }
      }
