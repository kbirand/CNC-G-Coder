    "Generates the same programs, then writes each one as 1:1 artwork for a laser engraver instead of G-code. The .ngc files are not kept.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Génère les mêmes programmes, puis écrit chacun en dessin 1:1 pour graveur laser au lieu de G-code. Les fichiers .ngc ne sont pas conservés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Genera los mismos programas y escribe cada uno como arte 1:1 para un grabador láser en lugar de G-code. Los archivos .ngc no se conservan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı programları üretir, sonra her birini G-code yerine lazer kazıyıcı için 1:1 çizim olarak yazar. .ngc dosyaları saklanmaz."
          }
        }
      }
    },
    "Generates the toolpaths with the current parameters and writes the .ngc programs — the files the preview is showing.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Génère les parcours avec les paramètres courants et écrit les programmes .ngc — les fichiers que montre l'aperçu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Genera las trayectorias con los parámetros actuales y escribe los programas .ngc: los archivos que muestra la vista previa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçerli parametrelerle takım yollarını üretir ve .ngc programlarını yazar — önizlemenin gösterdiği dosyalar."
          }
        }
      }
    },
