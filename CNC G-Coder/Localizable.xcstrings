    "Travel the X axis loses each time it reverses — the step the test cut's vertical line shows. 0 = off." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recorrido que pierde el eje X cada vez que invierte: el escalón que muestra la línea vertical del corte de prueba. 0 = desactivado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Course perdue par l'axe X à chaque inversion — la marche que montre la ligne verticale du test. 0 = désactivé."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "X ekseninin her yön değiştirdiğinde kaybettiği hareket — test kesiminin dikey çizgisinin gösterdiği basamak. 0 = kapalı."
          }
        }
      }
    },
    "Travel the Y axis loses each time it reverses — the step the test cut's horizontal line shows. 0 = off." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recorrido que pierde el eje Y cada vez que invierte: el escalón que muestra la línea horizontal del corte de prueba. 0 = desactivado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Course perdue par l'axe Y à chaque inversion — la marche que montre la ligne horizontale du test. 0 = désactivé."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Y ekseninin her yön değiştirdiğinde kaybettiği hareket — test kesiminin yatay çizgisinin gösterdiği basamak. 0 = kapalı."
          }
        }
      }
    },
