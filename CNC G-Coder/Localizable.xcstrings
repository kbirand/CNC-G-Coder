    },
    "Send the preamble above, then the program from line %lld. Needs the machine idle, not in alarm, with a trusted position." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviar el preámbulo de arriba y luego el programa desde la línea %lld. Necesita la máquina en reposo, sin alarma y con una posición fiable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyer le préambule ci-dessus, puis le programme à partir de la ligne %lld. Nécessite la machine au repos, sans alarme, avec une position fiable."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yukarıdaki başlangıcı, sonra programı %lld. satırdan gönder. Makinenin boşta, alarmsız ve güvenilir konumda olması gerekir."
          }
        }
      }
    },
    "Send the program flat, without the height map" : {
