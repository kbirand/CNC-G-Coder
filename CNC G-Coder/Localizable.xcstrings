    "Number of holding tabs spread around the outline. 4 suits most small boards." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número de pestañas de sujeción repartidas por el contorno. 4 sirve para la mayoría de placas pequeñas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombre de languettes de maintien réparties sur le contour. 4 convient à la plupart des petites cartes."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dış hat çevresine dağıtılan tutucu tırnak sayısı. 4, çoğu küçük karta uyar."
          }
        }
      }
    },
    "of %lld" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
