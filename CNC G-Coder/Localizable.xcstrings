          }
        }
      }
    },
    "V-bit tip": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pointe de la fraise en V"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Punta de la fresa en V"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "V uç noktası"
          }
        }
      }
    },
    "V-bits cut wider the deeper they go; their cutting width is worked out from tip, angle and depth.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fraises en V coupent plus large en profondeur ; leur largeur de coupe est calculée d'après pointe, angle et profondeur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fresas en V cortan más ancho cuanto más profundo; su ancho de corte se calcula a partir de punta, ángulo y profundidad."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "V uçlar derinleştikçe daha geniş keser; kesme genişlikleri uç, açı ve derinlikten hesaplanır."
          }
        }
      }
    },
    "Values": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Valeurs"
          }
        },
        "es": {
