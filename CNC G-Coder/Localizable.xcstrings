    "A program is already being sent — stop it in the Machine panel first." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya se está enviando un programa: deténgalo primero en el panel Machine."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un programme est déjà en cours d'envoi — arrêtez-le d'abord dans le panneau Machine."
          }
        },
        "tr" : {
