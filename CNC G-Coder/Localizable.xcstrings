    "Outline fonts are engraved along their contours; the single-stroke font as one line per stroke. Letters cannot be pocketed." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fuentes de contorno se graban a lo largo de sus contornos; la fuente de un trazo como una línea por trazo. Las letras no pueden vaciarse."
          }
        },
        "fr" : {
          "stringUnit" : {
