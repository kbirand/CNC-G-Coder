    "Rectangle (R): click or drag from one corner to the opposite one. Shift makes a square.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rectangle (R) : cliquez ou faites glisser d'un coin au coin opposé. Maj fait un carré."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rectángulo (R): haga clic o arrastre de una esquina a la opuesta. Mayús hace un cuadrado."
          }
        },
        "tr": {
