          "stringUnit": {
            "state": "translated",
            "value": "Profondeur de débourrage"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Profundidad de picoteo"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
