    "Abandon the job: reset, spindle off. Send from line… can pick it up later." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abandonar el trabajo: reset, husillo apagado. Send from line… puede retomarlo después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abandonner le travail : reset, broche coupée. Send from line… peut le reprendre plus tard."
          }
        },
        "tr" : {
