            "value": "Yeni takım ekle"
          }
        }
      }
    },
    "Add drill bits in the Tool Library…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des forets dans la bibliothèque d'outils…"
          }
        },
