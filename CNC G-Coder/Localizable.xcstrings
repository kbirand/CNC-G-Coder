    "top-silkscreen.ngc / bottom-silkscreen.ngc engrave the printed legend — reference designators, outlines and text — with overlapping passes. Run it last, after the mask.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "top-silkscreen.ngc / bottom-silkscreen.ngc gravent la légende imprimée — repères, contours et texte — par passes qui se chevauchent. À exécuter en dernier, après le vernis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "top-silkscreen.ngc / bottom-silkscreen.ngc graban la leyenda impresa —designadores, contornos y texto— con pasadas solapadas. Ejecútelo al final, después de la máscara."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "top-silkscreen.ngc / bottom-silkscreen.ngc basılı yazıları — referans adları, hatlar ve metin — örtüşen pasolarla kazır. En son, maskeden sonra çalıştırın."
          }
        }
      }
