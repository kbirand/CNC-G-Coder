    "Front side — copper top, drills, outline, top mask" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cara frontal: cobre superior, taladros, contorno, máscara superior"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face avant — cuivre supérieur, perçages, contour, vernis supérieur"
          }
