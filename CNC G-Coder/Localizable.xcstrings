    },
    "Disconnect while a program is running?" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Desconectar mientras se ejecuta un programa?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déconnecter pendant qu'un programme tourne ?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Program çalışırken bağlantı kesilsin mi?"
          }
        }
      }
    },
