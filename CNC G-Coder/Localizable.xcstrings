    "Add Gerber or Excellon drill files from anywhere as layers. Right-click a layer to replace or remove it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añada archivos Gerber o de taladrado Excellon desde cualquier sitio como capas. Clic derecho en una capa para sustituirla o quitarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez des fichiers Gerber ou de perçage Excellon de n'importe où comme couches. Clic droit sur une couche pour la remplacer ou la retirer."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herhangi bir yerden Gerber ya da Excellon delme dosyalarını katman olarak ekleyin. Değiştirmek ya da kaldırmak için bir katmana sağ tıklayın."
          }
        }
      }
    },
    "Add Hole" : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadir agujero"
          }
        },
