    "Shallowest to deepest isolation depth to test — one value per row, evenly spread.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profondeur d'isolation la moins à la plus profonde à tester — une valeur par ligne, réparties uniformément."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Profundidad de aislamiento de la más somera a la más profunda que probar: un valor por fila, repartidos uniformemente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Test edilecek en sığdan en derine izolasyon derinliği — satır başına bir değer, eşit dağıtılmış."
          }
        }
      }
    },
    "Shape": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forme"
          }
        },
        "es": {
          "stringUnit": {
