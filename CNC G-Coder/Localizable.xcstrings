    },
    "Clear width from the mask layers": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Largeur de dégagement d'après les couches de vernis"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancho de despeje según las capas de máscara"
          }
