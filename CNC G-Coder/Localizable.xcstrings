    "No machine positions yet. Jog to a spot and click Save current.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune position machine pour l'instant. Déplacez-vous vers un point et cliquez Save current."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay posiciones de máquina. Mueva el husillo a un punto y pulse Save current."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz makine konumu yok. Bir noktaya jog yapın ve Save current'a tıklayın."
          }
        }
      }
    },
    "No macros yet. Each macro in the Macros tab becomes a button here.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune macro. Chaque macro de l'onglet Macros devient un bouton ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay macros. Cada macro de la pestaña Macros se convierte en un botón aquí."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz makro yok. Macros sekmesindeki her makro burada bir düğme olur."
          }
        }
      }
    },
    "No macros. Click Add to create one.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune macro. Cliquez Ajouter pour en créer une."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay macros. Pulse Añadir para crear una."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Makro yok. Oluşturmak için Ekle'ye tıklayın."
          }
        }
      }
    },
    "No permission to write to %@ — use Choose… to pick the folder.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d'autorisation d'écrire dans %@ — utilisez Choisir… pour sélectionner le dossier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin permiso para escribir en %@: use Elegir… para seleccionar la carpeta."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ konumuna yazma izni yok — klasörü seçmek için Seç… kullanın."
          }
        }
      }
    },
    "No positions saved yet. Jog to a spot and click Save current, or Save work zero.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune position enregistrée. Joggez jusqu'à un point et cliquez Save current, ou Save work zero."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay posiciones guardadas. Haga jog a un punto y pulse Save current, o Save work zero."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz kayıtlı konum yok. Bir noktaya jog yapıp Save current'a ya da Save work zero'ya tıklayın."
          }
        }
      }
    },
    "No presets saved": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun preset enregistré"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay presets guardados"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı preset yok"
          }
        }
      }
    },
    "No preview yet": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore d'aperçu"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay vista previa"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz önizleme yok"
          }
        }
      }
    },
    "No preview yet — choose a project folder, then Refresh.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore d'aperçu — choisissez un dossier de projet, puis Rafraîchir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay vista previa: elija una carpeta de proyecto y luego Actualizar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz önizleme yok — bir proje klasörü seçin, sonra Yenile."
          }
        }
      }
    },
    "No program": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun programme"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin programa"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Program yok"
          }
        }
      }
    },
    "No program generated": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun programme généré"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún programa generado"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Program üretilmedi"
          }
        }
      }
    },
    "No project": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun projet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin proyecto"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Proje yok"
          }
        }
      }
    },
    "No reference set. Jog the bit a few millimetres above the spot, then:": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune référence définie. Amenez la fraise quelques millimètres au-dessus du point, puis :"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay referencia. Lleve la fresa unos milímetros sobre el punto y luego:"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Referans ayarlı değil. Ucu noktanın birkaç milimetre üzerine getirin, sonra:"
          }
        }
      }
    },
    "No shapes yet — pick a tool in the bar above the preview and draw. Shapes snap to the grid, guides and each other.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune forme — choisissez un outil dans la barre au-dessus de l'aperçu et dessinez. Les formes s'accrochent à la grille, aux guides et entre elles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay formas: elija una herramienta en la barra sobre la vista previa y dibuje. Las formas se ajustan a la cuadrícula, las guías y entre sí."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz şekil yok — önizlemenin üstündeki çubuktan bir araç seçip çizin. Şekiller ızgaraya, kılavuzlara ve birbirine yapışır."
          }
        }
      }
    },
    "No work zeros yet. Zero the machine on the board and click Save work zero — or send a program with the automatic save on.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun zéro pièce pour l'instant. Faites le zéro sur la carte et cliquez Save work zero — ou envoyez un programme avec l'enregistrement automatique activé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay ceros de trabajo. Haga cero sobre la placa y pulse Save work zero, o envíe un programa con el guardado automático activado."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz iş sıfırı yok. Makineyi kart üzerinde sıfırlayın ve Save work zero'ya tıklayın — ya da otomatik kayıt açıkken bir program gönderin."
          }
        }
      }
    },
    "Nominal hole sizes to test, separated by spaces — e.g. the pins you need to fit: 2 3 4. Use a point for decimals (3.175).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailles de trous nominales à tester, séparées par des espaces — p. ex. les broches à ajuster : 2 3 4. Utilisez un point pour les décimales (3.175)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamaños nominales de agujero que probar, separados por espacios, p. ej. los pines que necesita encajar: 2 3 4. Use punto para los decimales (3.175)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Test edilecek nominal delik boyutları, boşlukla ayrılmış — örn. oturtmanız gereken pimler: 2 3 4. Ondalık için nokta kullanın (3.175)."
          }
        }
      }
    },
    "None checked: every hole in this file is drilled at its designed size, one bit per size.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien de coché : chaque trou de ce fichier est percé à sa taille de conception, un foret par taille."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna marcada: cada agujero de este archivo se taladra a su tamaño de diseño, una broca por tamaño."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbiri işaretli değil: bu dosyadaki her delik tasarlanan boyutunda, boyut başına bir uçla delinir."
          }
        }
      }
    },
    "Not connected": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non connecté"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No conectado"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlı değil"
          }
        }
      }
    },
    "Not found": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Introuvable"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No encontrado"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulunamadı"
          }
        }
      }
    },
    "Not ready": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas prêt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No listo"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazır değil"
          }
        }
      }
    },
    "Not responding": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne répond pas"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No responde"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanıt vermiyor"
          }
        }
      }
    },
    "Notes": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Notas"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notlar"
          }
        }
      }
    },
    "Nothing to generate — open a project, or draw on a custom layer.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à générer — ouvrez un projet, ou dessinez sur une couche personnalisée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada que generar: abra un proyecto o dibuje en una capa personalizada."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üretilecek bir şey yok — bir proje açın ya da özel bir katmana çizin."
          }
        }
      }
    },
    "Now at: %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Actuellement à : %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora en: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu an: %@"
          }
        }
      }
    },
    "Number of holding tabs spread around the outline. 4 suits most small boards.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombre de languettes de maintien réparties sur le contour. 4 convient à la plupart des petites cartes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Número de pestañas de sujeción repartidas por el contorno. 4 sirve para la mayoría de placas pequeñas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dış hat çevresine dağıtılan tutucu tırnak sayısı. 4, çoğu küçük karta uyar."
          }
        }
      }
    },
    "Off": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapalı"
          }
        }
      }
    },
    "Off: Continue in the tool-change banner resumes at once (the banner shows the lines it will send). Send from line… always shows its preamble first.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé : Continuer dans la bannière de changement d'outil reprend aussitôt (la bannière montre les lignes à envoyer). Send from line… montre toujours son préambule d'abord."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado: Continuar en el cartel de cambio de herramienta reanuda al instante (el cartel muestra las líneas que enviará). Send from line… siempre muestra su preámbulo primero."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapalı: takım değiştirme afişindeki Devam Et hemen sürdürür (afiş göndereceği satırları gösterir). Send from line… her zaman önce başlangıcını gösterir."
          }
        }
      }
    },
    "Off: Send streams at once. Settings → Machine turns the reminder back on.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé : Send diffuse aussitôt. Réglages → Machine réactive le rappel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado: Send transmite de inmediato. Ajustes → Machine vuelve a activar el recordatorio."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapalı: Send hemen akıtır. Ayarlar → Machine hatırlatmayı yeniden açar."
          }
        }
      }
    },
    "Off: every hole in this file is drilled.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé : chaque trou de ce fichier est percé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado: cada agujero de este archivo se taladra."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapalı: bu dosyadaki her delik delinir."
          }
        }
      }
    },
    "Off: silkscreen layers are ignored (the default — engraving them costs generation and machining time). Engrave: mill the legend strokes themselves, so component outlines and labels end up cut into the board. Either way the layer can be sent to a laser from the export below once a program exists.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé : les couches de sérigraphie sont ignorées (par défaut — les graver coûte du temps de génération et d'usinage). Graver : fraise les traits de la légende, les contours et étiquettes de composants finissent gravés dans la carte. Dans tous les cas la couche peut être envoyée à un laser depuis l'export ci-dessous dès qu'un programme existe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado: las capas de serigrafía se ignoran (por defecto; grabarlas cuesta tiempo de generación y mecanizado). Grabar: fresa los propios trazos de la leyenda, así que contornos y etiquetas de componentes quedan grabados en la placa. En cualquier caso la capa puede enviarse a un láser desde la exportación de abajo en cuanto exista un programa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapalı: serigrafi katmanları yok sayılır (varsayılan — kazımak üretim ve işleme süresine mal olur). Kazı: yazıların çizgilerini frezeler; bileşen hatları ve etiketler karta kazınmış olur. Her iki durumda da bir program var olduğunda katman aşağıdaki dışa aktarmayla lazere gönderilebilir."
          }
        }
      }
    },
    "Offer the built-in FluidNC simulator as a third transport in the connection bar": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Proposer le simulateur FluidNC intégré comme troisième transport dans la barre de connexion"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ofrecer el simulador FluidNC integrado como tercer transporte en la barra de conexión"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı çubuğunda yerleşik FluidNC simülatörünü üçüncü aktarım olarak sun"
          }
        }
      }
    },
    "On (%@): every program the app writes gets a short take-up move wherever that axis reverses; the preview and G-code tab show the uncompensated program. Set back to 0 once the machine is repaired.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé (%@) : chaque programme écrit par l'app reçoit un court mouvement de rattrapage à chaque inversion de cet axe ; l'aperçu et l'onglet G-code montrent le programme non compensé. Remettez à 0 une fois la machine réparée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado (%@): cada programa que escribe la app recibe un breve movimiento de recuperación donde ese eje invierte; la vista previa y la pestaña G-code muestran el programa sin compensar. Vuelva a 0 cuando la máquina esté reparada."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık (%@): uygulamanın yazdığı her program, o eksen yön değiştirdiğinde kısa bir boşluk alma hareketi alır; önizleme ve G-code sekmesi telafisiz programı gösterir. Makine onarıldığında 0'a geri alın."
          }
        }
      }
    },
    "One G-code or $ command per line, sent in order with the machine idle. @goto <saved position> expands to a safe move to that position (Z first when rising).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une commande G-code ou $ par ligne, envoyées dans l'ordre avec la machine au repos. @goto <position enregistrée> se développe en un déplacement sûr vers cette position (Z d'abord en montant)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un comando G-code o $ por línea, enviados en orden con la máquina en reposo. @goto <posición guardada> se expande a un movimiento seguro a esa posición (Z primero al subir)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satır başına bir G-code ya da $ komutu; makine boştayken sırayla gönderilir. @goto <kayıtlı konum> o konuma güvenli bir harekete açılır (yükselirken önce Z)."
          }
        }
      }
    },
    "One command per line. `@goto <saved position>` moves there safely (Z first when rising).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une commande par ligne. `@goto <position enregistrée>` s'y rend en sécurité (Z d'abord en montant)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un comando por línea. `@goto <posición guardada>` va allí de forma segura (Z primero al subir)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satır başına bir komut. `@goto <kayıtlı konum>` oraya güvenle gider (yükselirken önce Z)."
          }
        }
      }
    },
    "One program per layer, machined with this one tool. Programs are written by Generate and by the CNC export below, like every other layer.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un programme par couche, usiné avec ce seul outil. Les programmes sont écrits par Générer et par l'export CNC ci-dessous, comme toute autre couche."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un programa por capa, mecanizado con esta única herramienta. Los programas los escriben Generar y la exportación CNC de abajo, como cualquier otra capa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Katman başına bir program, bu tek takımla işlenir. Programlar diğer her katman gibi Üret ve aşağıdaki CNC dışa aktarma tarafından yazılır."
          }
        }
      }
    },
    "One row per drill size. Changing a size changes every hole drilled with it. To change only some holes, select them in the preview. The toolpaths regenerate when you press Done.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une ligne par taille de foret. Changer une taille change chaque trou percé avec elle. Pour ne changer que certains trous, sélectionnez-les dans l'aperçu. Les parcours se régénèrent quand vous appuyez sur Done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una fila por tamaño de broca. Cambiar un tamaño cambia cada agujero taladrado con él. Para cambiar solo algunos agujeros, selecciónelos en la vista previa. Las trayectorias se regeneran al pulsar Done."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Matkap boyutu başına bir satır. Bir boyutu değiştirmek onunla delinen her deliği değiştirir. Yalnızca bazı delikleri değiştirmek için önizlemede seçin. Takım yolları Done'a bastığınızda yeniden üretilir."
          }
        }
      }
    },
    "Only the selected holes change. To resize every hole of a size, use the tool table in the sidebar.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les trous sélectionnés changent. Pour redimensionner tous les trous d'une taille, utilisez la table d'outils de la barre latérale."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo cambian los agujeros seleccionados. Para redimensionar todos los agujeros de un tamaño, use la tabla de herramientas de la barra lateral."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca seçili delikler değişir. Bir boyuttaki her deliği yeniden boyutlandırmak için kenar çubuğundaki takım tablosunu kullanın."
          }
        }
      }
    },
    "Only the selected pads change; other pads of this size keep theirs.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les pastilles sélectionnées changent ; les autres de cette taille gardent la leur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo cambian los pads seleccionados; los demás de este tamaño conservan el suyo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca seçili pad'ler değişir; bu boyuttaki diğer pad'ler kendi boyutlarını korur."
          }
        }
      }
    },
