          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matkap Ø %1$@ mm · ağız %2$@ mm · sap %3$@ mm"
          }
        }
      }
    },
    "Drill Ø %1$@ mm · flutes %2$@ mm · shank %3$@ mm" : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Broca Ø %1$@ mm · filos %2$@ mm · vástago %3$@ mm"
          }
        },
        "fr" : {
