    "Positions are machine coordinates. Save the work zero so it can be restored after a reset or re-homing.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les positions sont en coordonnées machine. Enregistrez le zéro pièce pour pouvoir le restaurer après un reset ou un nouveau référencement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las posiciones son coordenadas de máquina. Guarde el cero de trabajo para poder restaurarlo tras un reset o un nuevo homing."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konumlar makine koordinatlarıdır. Reset ya da yeniden home'dan sonra geri getirilebilmesi için iş sıfırını kaydedin."
          }
        }
      }
    },
