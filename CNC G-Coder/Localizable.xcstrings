            "state" : "translated",
            "value" : "Capa de cobre superior (Gerber_TopLayer.GTL). Se convierte en front-copper.ngc: fresado de aislamiento alrededor de cada pista y pad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couche de cuivre supérieure (Gerber_TopLayer.GTL). Devient front-copper.ngc — fraisage d'isolation autour de chaque piste et pastille."
          }
        },
        "tr" : {
