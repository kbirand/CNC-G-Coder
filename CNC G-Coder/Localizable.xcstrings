      }
    },
    "Z moves first when the target is higher than the current Z, otherwise X and Y move first." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z se mueve primero cuando el destino es más alto que la Z actual; si no, X e Y se mueven primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z bouge d'abord quand la cible est plus haute que le Z actuel, sinon X et Y bougent d'abord."
          }
        },
        "tr" : {
          "stringUnit" : {
