    },
    "Go to Work Zero first rises to this work Z, then moves over X0 Y0 — high enough to clear clamps": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to Work Zero monte d'abord à ce Z pièce, puis se place au-dessus de X0 Y0 — assez haut pour passer au-dessus des brides"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to Work Zero sube primero a esta Z de trabajo y luego se sitúa sobre X0 Y0; lo bastante alto para salvar las mordazas"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to Work Zero önce bu iş Z'sine yükselir, sonra X0 Y0 üzerine gider — mengeneleri aşacak kadar yüksek"
          }
        }
      }
    },
    "Go to coordinates": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
