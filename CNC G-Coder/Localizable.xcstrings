            "value": "Dış çap"
          }
        }
      }
    },
    "Outline": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contour"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contorno"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dış hat"
          }
        }
      }
    },
    "Outline fonts are engraved along their contours; the single-stroke font as one line per stroke. Letters cannot be pocketed.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les polices vectorielles sont gravées le long de leurs contours ; la police monotrait en une ligne par trait. Les lettres ne peuvent pas être évidées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fuentes de contorno se graban a lo largo de sus contornos; la fuente de un trazo como una línea por trazo. Las letras no pueden vaciarse."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dış hatlı yazı tipleri hatları boyunca kazınır; tek çizgili yazı tipi çizgi başına bir çizgi olarak. Harfler boşaltılamaz."
          }
        }
      }
    },
    "Output": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortie"
          }
        },
        "es": {
