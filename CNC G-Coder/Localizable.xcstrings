    "Send the line to the controller (Return). ↑ and ↓ in the field recall earlier commands.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyer la ligne au contrôleur (Retour). ↑ et ↓ dans le champ rappellent les commandes précédentes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar la línea al controlador (Retorno). ↑ y ↓ en el campo recuperan comandos anteriores."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satırı denetleyiciye gönder (Return). Alandaki ↑ ve ↓ önceki komutları geri çağırır."
          }
        }
      }
    },
    "Send the lines one after another and wait for each to be acknowledged": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyer les lignes l'une après l'autre en attendant chaque acquittement"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar las líneas una tras otra y esperar la confirmación de cada una"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satırları art arda gönder ve her birinin onayını bekle"
          }
        }
      }
    },
    "Send the preamble above, then the program from line %lld. Needs the machine idle, not in alarm, with a trusted position.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyer le préambule ci-dessus, puis le programme à partir de la ligne %lld. Nécessite la machine au repos, sans alarme, avec une position fiable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar el preámbulo de arriba y luego el programa desde la línea %lld. Necesita la máquina en reposo, sin alarma y con una posición fiable."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yukarıdaki başlangıcı, sonra programı %lld. satırdan gönder. Makinenin boşta, alarmsız ve güvenilir konumda olması gerekir."
          }
        }
      }
    },
    "Send the program flat, without the height map": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyer le programme à plat, sans la carte de hauteur"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar el programa plano, sin el mapa de altura"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Programı yükseklik haritasız, düz gönder"
          }
        }
      }
    },
    "Sent as typed; a single character like ! ~ ? is sent as a real-time byte": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyé tel que saisi ; un caractère seul comme ! ~ ? est envoyé en octet temps réel"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se envía tal como se escribe; un solo carácter como ! ~ ? se envía como byte en tiempo real"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazıldığı gibi gönderilir; ! ~ ? gibi tek bir karakter gerçek zamanlı bayt olarak gönderilir"
          }
        }
      }
    },
    "Sent to machine: %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyé à la machine : %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviado a la máquina: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Makineye gönderildi: %@"
          }
        }
      }
    },
    "Separate the values with spaces and use a point for decimals, e.g. 2 3 4 and -0.05 0 0.05 0.10.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Séparez les valeurs par des espaces et utilisez un point pour les décimales, p. ex. 2 3 4 et -0.05 0 0.05 0.10."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Separe los valores con espacios y use un punto para los decimales, p. ej. 2 3 4 y -0.05 0 0.05 0.10."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değerleri boşlukla ayırın ve ondalık için nokta kullanın, örn. 2 3 4 ve -0.05 0 0.05 0.10."
          }
        }
      }
    },
    "Serial port:": {
      "localizations": {
