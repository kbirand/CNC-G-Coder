    "mm" : {
      "comment" : "A unit of length.",
      "isCommentAutoGenerated" : true
    },
    "mm · travel / limit" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mm · recorrido / límite"
          }
