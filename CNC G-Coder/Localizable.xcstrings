          }
        }
      }
    },
    "Stop probing (the points recorded so far are discarded)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter le palpage (les points enregistrés jusqu'ici sont abandonnés)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detener el palpado (los puntos registrados hasta ahora se descartan)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Problamayı durdur (şu ana kadar kaydedilen noktalar atılır)"
          }
        }
      }
    },
    "Stop spindle": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter la broche"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detener husillo"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İş milini durdur"
          }
        }
      }
    },
    "Stop the job before changing the project. Stopping holds the machine, resets the controller and leaves the spindle off.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêtez le travail avant de changer de projet. L'arrêt met la machine en pause, réinitialise le contrôleur et laisse la broche coupée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detenga el trabajo antes de cambiar de proyecto. Detener pone la máquina en pausa, resetea el controlador y deja el husillo apagado."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Projeyi değiştirmeden önce işi durdurun. Durdurmak makineyi duraklatır, denetleyiciyi sıfırlar ve iş milini kapalı bırakır."
          }
        }
      }
    },
    "Stop — keep showing the previous result": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter — continuer d'afficher le résultat précédent"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detener: seguir mostrando el resultado anterior"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durdur — önceki sonucu göstermeye devam et"
          }
        }
      }
    },
    "Stopping…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêt…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deteniendo…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durduruluyor…"
          }
        }
      }
    },
    "Stops after the stage that is currently running.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'arrête après l'étape en cours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se detiene tras la etapa en curso."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "O anda çalışan aşamadan sonra durur."
          }
        }
      }
    },
    "Store the machine coordinates the spindle is at now": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mémoriser les coordonnées machine où se trouve la broche"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar las coordenadas de máquina en las que está ahora el husillo"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İş milinin şu an bulunduğu makine koordinatlarını sakla"
          }
        }
      }
    },
    "Store where work X0 Y0 Z0 is in machine coordinates, so the zero can be restored later with Use as zero": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mémoriser où se trouve X0 Y0 Z0 pièce en coordonnées machine, pour restaurer le zéro plus tard avec Use as zero"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar dónde está el X0 Y0 Z0 de trabajo en coordenadas de máquina, para restaurar el cero después con Use as zero"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İş X0 Y0 Z0'ının makine koordinatlarında nerede olduğunu sakla; böylece sıfır daha sonra Use as zero ile geri getirilebilir"
          }
        }
      }
    },
    "Stores all current machining parameters under this name.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mémorise tous les paramètres d'usinage actuels sous ce nom."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda todos los parámetros de mecanizado actuales con este nombre."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm geçerli işleme parametrelerini bu adla saklar."
          }
        }
      }
    },
    "Straight": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Droite"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recta"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düz"
          }
        }
      }
    },
    "Straight bits cut their own diameter. V-bits cut wider the deeper they go: enter tip and angle and the width at depth is worked out for you — and follows the depth as you change it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fraises droites coupent à leur propre diamètre. Les fraises en V coupent plus large en profondeur : saisissez pointe et angle, la largeur à la profondeur est calculée pour vous — et suit la profondeur quand vous la changez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fresas rectas cortan su propio diámetro. Las fresas en V cortan más ancho cuanto más profundo: introduzca punta y ángulo y el ancho a la profundidad se calcula por usted, y sigue a la profundidad cuando la cambia."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düz uçlar kendi çaplarında keser. V uçlar derinleştikçe daha geniş keser: uç ve açıyı girin, derinlikteki genişlik sizin için hesaplanır — ve derinliği değiştirdikçe onu izler."
          }
        }
      }
    },
    "Stream %@ to the machine": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diffuser %@ à la machine"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transmitir %@ a la máquina"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ makineye akıt"
