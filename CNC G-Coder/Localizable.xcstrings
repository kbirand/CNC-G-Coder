            "value": "Dikey Dağıt"
          }
        }
      }
    },
    "Do not start; the job stays as it is": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne pas démarrer ; le travail reste tel quel"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No iniciar; el trabajo queda como está"
          }
        },
        "tr": {
