        }
      }
    },
    "Make this machine point the work origin again (G10 L2) — the machine does not move. Right-click the row to rename, overwrite or delete it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volver a convertir este punto de máquina en el origen de trabajo (G10 L2); la máquina no se mueve. Clic derecho en la fila para renombrar, sobrescribir o eliminar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refaire de ce point machine l'origine pièce (G10 L2) — la machine ne bouge pas. Clic droit sur la ligne pour renommer, écraser ou supprimer."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu makine noktasını yeniden iş başlangıcı yap (G10 L2) — makine hareket etmez. Yeniden adlandırmak, üzerine yazmak ya da silmek için satıra sağ tıklayın."
          }
        }
