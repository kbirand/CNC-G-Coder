    "Add a layer to draw on — lines, rectangles, circles and text, machined with a tool of your choice." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadir una capa sobre la que dibujar: líneas, rectángulos, círculos y texto, mecanizados con la herramienta que elija."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajouter une couche sur laquelle dessiner — lignes, rectangles, cercles et texte, usinés avec l'outil de votre choix."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Üzerine çizim yapılacak bir katman ekleyin — çizgiler, dikdörtgenler, daireler ve metin; seçtiğiniz bir takımla işlenir."
          }
        }
      }
    },
