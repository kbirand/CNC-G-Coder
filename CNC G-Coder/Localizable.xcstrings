    "Length of the short jog commands sent one after another while a button is held, on firmware that cannot cancel a long jog": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Longueur des courtes commandes de jog envoyées à la suite pendant qu'un bouton est maintenu, sur les firmwares qui ne peuvent pas annuler un long jog"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Longitud de los comandos de jog cortos enviados uno tras otro mientras se mantiene un botón, en firmware que no puede cancelar un jog largo"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzun bir jog'u iptal edemeyen aygıt yazılımında, bir düğme basılıyken art arda gönderilen kısa jog komutlarının uzunluğu"
          }
        }
      }
    },
