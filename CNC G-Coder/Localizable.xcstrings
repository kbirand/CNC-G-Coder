    "Text (T): set the text and its height in the bar, then click where the baseline starts.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Texte (T) : réglez le texte et sa hauteur dans la barre, puis cliquez là où commence la ligne de base."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto (T): fije el texto y su altura en la barra, luego haga clic donde empieza la línea base."
          }
        },
        "tr": {
          "stringUnit": {
