            "value": "Gerber dışa aktarım klasörünü seçin (EasyEDA ya da KiCad: Gerber + delme dosyaları)."
          }
        }
      }
    },
    "Choose the file for %@.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez le fichier pour %@."
          }
        },
        "es": {
