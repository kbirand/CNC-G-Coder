    "Top copper layer (Gerber_TopLayer.GTL). Becomes front-copper.ngc — isolation milling around every trace and pad.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couche de cuivre supérieure (Gerber_TopLayer.GTL). Devient front-copper.ngc — fraisage d'isolation autour de chaque piste et pastille."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capa de cobre superior (Gerber_TopLayer.GTL). Se convierte en front-copper.ngc: fresado de aislamiento alrededor de cada pista y pad."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üst bakır katmanı (Gerber_TopLayer.GTL). front-copper.ngc olur — her izin ve pad'in çevresinde izolasyon frezelemesi."
          }
        }
      }
    },
    "Top mask": {
      "localizations": {
