    "English, French, Spanish and Turkish. Changing it takes effect at the next launch." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inglés, francés, español y turco. El cambio surte efecto en el siguiente arranque."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anglais, français, espagnol et turc. Le changement prend effet au prochain lancement."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İngilizce, Fransızca, İspanyolca ve Türkçe. Değişiklik bir sonraki açılışta etkili olur."
          }
        }
      }
    },
    "Engrave" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grabar"
          }
        },
        "fr" : {
