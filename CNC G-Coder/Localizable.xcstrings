    },
    "Probe points along X (2–15). Points about 10 mm apart follow a warped board well; more points take longer to probe.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Points de palpage le long de X (2–15). Des points espacés d'environ 10 mm suivent bien une carte voilée ; plus de points prennent plus de temps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puntos de palpado a lo largo de X (2–15). Puntos a unos 10 mm siguen bien una placa alabeada; más puntos tardan más."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "X boyunca prob noktaları (2–15). Yaklaşık 10 mm aralıklı noktalar eğri bir kartı iyi izler; daha çok nokta problamayı uzatır."
          }
        }
      }
    },
    "Probe points along X and Y (2–15 each). Points about 10 mm apart follow a warped board well; more points take longer to probe.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Points de palpage le long de X et Y (2–15 chacun). Des points espacés d'environ 10 mm suivent bien une carte voilée ; plus de points prennent plus de temps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puntos de palpado a lo largo de X e Y (2–15 cada uno). Puntos a unos 10 mm siguen bien una placa alabeada; más puntos tardan más en palparse."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "X ve Y boyunca prob noktaları (her biri 2–15). Yaklaşık 10 mm aralıklı noktalar eğri bir kartı iyi izler; daha çok nokta problamayı uzatır."
          }
        }
      }
    },
    "Probe points along Y (2–15). Points about 10 mm apart follow a warped board well; more points take longer to probe.": {
      "localizations": {
        "fr": {
          "stringUnit": {
