    },
    "Emergency stop (⇧⌘.): jog cancel, feed hold and reset at once — the position is lost if the machine was moving" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parada de emergencia (⇧⌘.): cancelar jog, feed hold y reset a la vez; la posición se pierde si la máquina se movía"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêt d'urgence (⇧⌘.) : annulation du jog, feed hold et reset d'un coup — la position est perdue si la machine bougeait"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acil durdurma (⇧⌘.): jog iptali, feed hold ve reset bir arada — makine hareket ediyorduysa konum kaybolur"
          }
        }
      }
    },
    "Empty — draw with the tools above the preview" : {
