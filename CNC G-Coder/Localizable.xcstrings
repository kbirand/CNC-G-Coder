    "%@\n\nThe machine is in feed hold. Ignore skips nothing — the controller already rejected the line — and resumes with the next one." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nLa máquina está en feed hold. Ignorar no se salta nada —el controlador ya rechazó la línea— y reanuda con la siguiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nLa machine est en feed hold. Ignorer ne saute rien — le contrôleur a déjà rejeté la ligne — et reprend à la suivante."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nMakine feed hold durumunda. Yoksay hiçbir şeyi atlamaz — denetleyici satırı zaten reddetti — ve bir sonrakiyle devam eder."
          }
        }
      }
    },
    "%@\nat %lld mm/min. Z moves first if it is going up, otherwise last." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\na %2$lld mm/min. Z se mueve primero si sube; si no, al final."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\nà %2$lld mm/min. Z bouge d'abord s'il monte, sinon en dernier."
