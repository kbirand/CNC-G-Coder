          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nueva macro: un nombre, un icono opcional y las líneas de G-code que envía. También se convierte en un botón de usuario en la pestaña Control."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni makro: bir ad, isteğe bağlı bir simge ve gönderdiği G-code satırları. Control sekmesinde bir kullanıcı düğmesi de olur."
          }
        }
      }
    },
