<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- First launch of the sandboxed app: macOS moves these into the
	     container (tool library, saved positions, height maps, settings). -->
	<key>Move</key>
	<array>
		<string>${ApplicationSupport}/CNC G-Coder</string>
		<string>${Library}/Preferences/${BundleId}.plist</string>
	</array>
</dict>
</plist>
